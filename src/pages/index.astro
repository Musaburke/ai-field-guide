---
import Guide from '../layouts/Guide.astro';
import Constellation from '../components/Constellation.astro';
import PromptPicker from '../components/PromptPicker.astro';
import Rich from '../components/Rich';
import { sections } from '../data/guide';
import { blurbs, groups, icons } from '../data/panels';
import { rules, wins } from '../data/playbooks';
import { claimHref, countWord } from '../lib/content';
---
<Guide title="AI field guide" description="Practical guides to using AI well: what to use it for, how to ask, and what to check. For students and professionals, with every claim sourced." current="/">
  <div class="wash">
    <Constellation />
    <div class="wrap hero">
      <div>
        <h1 data-split>Get more out of AI,<br /> and stay sharp</h1>
        <p class="hero-lead" data-reveal style="--d:250ms">What to use it for, how to ask, and what to check. Practical guides for students and professionals, with sources you can open.</p>
        <div class="hero-cta" data-reveal style="--d:350ms">
          <a class="btn" href={`/${sections[0]!.id}`}>Start with the basics</a>
          <a class="btn btn-soft" href="#guides">See all {countWord(sections.length).toLowerCase()} guides</a>
        </div>
      </div>
      <div data-reveal style="--d:300ms"><PromptPicker /></div>
    </div>
  </div>

  <div class="wrap">
    <section class="block" id="guides" aria-labelledby="ch-h">
      <div class="sec-head">
        <h2 id="ch-h" data-split>{countWord(sections.length)} short guides</h2>
        <p>In three groups. Start at the top if you are new.</p>
      </div>
      <div class="groups">
        {groups.map((gr) => (
          <div class="group" data-reveal>
            <div class="group-head">
              <h3>{gr.title}</h3>
              <p>{gr.line}</p>
            </div>
            <ul class="group-cards">
              {gr.guides.map((id) => {
                const g = sections.find((x) => x.id === id)!;
                return (
                  <li><a class="ch-card" href={`/${id}`}>
                    <span class="ch-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[id]} /></svg></span>
                    <span class="ch-text"><b>{g.title}</b><span>{blurbs[id]}</span></span>
                  </a></li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="block" aria-labelledby="wins-h">
      <h2 id="wins-h" data-split>Where AI has really helped</h2>
      <div class="wins">
        {wins.map((w, i) => (
          <a href={claimHref(w.claim)} data-reveal style={`--d:${i * 60}ms`}>
            <b>{w.value}</b>
            <span>{w.text}</span>
            <small>{w.limit}</small>
          </a>
        ))}
      </div>
    </section>

    <section class="block" aria-labelledby="rules-h">
      <h2 id="rules-h" data-split>Three rules for using it wisely</h2>
      <ul class="rule-strip" data-reveal>
        {rules.map((r) => (
          <li><h3>{r.title}</h3><p><Rich text={r.text} current="/" /></p></li>
        ))}
      </ul>
    </section>
  </div>
</Guide>
