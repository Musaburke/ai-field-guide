---
import Guide from '../layouts/Guide.astro';
import Constellation from '../components/Constellation.astro';
import { ReadLine } from '../components/Evidence';
import { sections } from '../data/guide';
import { figures } from '../data/display';
import { blurbs, icons, sourceNames } from '../data/panels';
import { allClaims, claimHref } from '../lib/content';

const metr = allClaims.find((c) => c.id === 'metr-2025')!;
---
<Guide title="AI field guide" description="What the evidence really says about using AI at work, in plain English, with every claim sourced." current="/">
  <div class="wash">
    <Constellation />
    <div class="wrap hero">
      <div>
        <h1 data-split>Use AI <span class="hero-word" data-rotate="well|safely|responsibly">well</span></h1>
        <p class="hero-lead" data-reveal style="--d:250ms">What the evidence really says, in plain English. For students and professionals.</p>
        <div class="hero-cta" data-reveal style="--d:350ms">
          <a class="btn" href={`/${sections[0]!.id}`}>Start reading</a>
          <a class="btn btn-soft" href="/evidence">See the evidence</a>
        </div>
      </div>
      <div class="demo" data-reveal style="--d:300ms">
        <div class="bubble"><small>You ask</small><p>Does AI make developers faster?</p></div>
        <div class="bubble"><small>The evidence says</small><span class="big-num">19% longer</span><p>In one small 2025 trial of 16 developers.</p></div>
        <div class="bubble bubble-check"><small>How sure to be</small><p>{metr.strength}</p><div class="check-row"><ReadLine read={metr.read} /><span class="read-line">Contested</span></div></div>
      </div>
    </div>
  </div>

  <div class="wrap">
    <section class="strip" aria-label="Sources used" data-reveal>
      <p>Sources used include</p>
      <ul>{sourceNames.map((n) => <li>{n}</li>)}</ul>
    </section>

    <section class="block" aria-labelledby="ch-h">
      <h2 id="ch-h" data-split>Six short chapters</h2>
      <div class="chapters">
        {sections.map((s, i) => (
          <a class="ch-card" href={`/${s.id}`} data-reveal style={`--d:${i * 60}ms`}>
            <span class="ch-top"><span class="ch-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[s.id]} /></svg></span><span class="ch-n">Chapter {i + 1}</span></span>
            <h3>{s.title}</h3>
            <p>{blurbs[s.id]}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="block" aria-labelledby="num-h">
      <h2 id="num-h" data-split>The numbers, with their caveats</h2>
      <div class="wall">
        {figures.map((f, i) => (
          <a href={claimHref(f.claim)} data-reveal style={`--d:${i * 60}ms`}><b>{f.value}</b><span>{f.label}</span></a>
        ))}
      </div>
    </section>

    <a class="band" href={`/${sections[0]!.id}`}><span>Chapter 1</span><b>{sections[0]!.title}</b></a>
  </div>
</Guide>
