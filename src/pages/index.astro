---
import Guide from '../layouts/Guide.astro';
import Constellation from '../components/Constellation.astro';
import PromptPicker from '../components/PromptPicker.astro';
import Rich from '../components/Rich';
import { sections } from '../data/guide';
import { blurbs, icons } from '../data/panels';
import { rules, wins } from '../data/playbooks';
import { claimHref } from '../lib/content';
---
<Guide title="AI field guide" description="Practical guides to using AI well: what to use it for, how to ask, and what to check. For students and professionals, with every claim sourced." current="/">
  <div class="wash">
    <Constellation />
    <div class="wrap hero">
      <div>
        <h1 data-split>Get more out of AI,<br /> and stay sharp</h1>
        <p class="hero-lead" data-reveal style="--d:250ms">What to use it for, how to ask, and what to check. Practical guides for students and professionals, with sources you can open.</p>
        <div class="hero-cta" data-reveal style="--d:350ms">
          <a class="btn" href={`/${sections[0]!.id}`}>Start with the basics</a>
          <a class="btn btn-soft" href="#guides">See all seven guides</a>
        </div>
      </div>
      <div data-reveal style="--d:300ms"><PromptPicker /></div>
    </div>
  </div>

  <div class="wrap">
    <section class="block" aria-labelledby="wins-h">
      <h2 id="wins-h" data-split>Where AI has really helped</h2>
      <div class="wins">
        {wins.map((w, i) => (
          <a href={claimHref(w.claim)} data-reveal style={`--d:${i * 60}ms`}>
            <b>{w.value}</b>
            <span>{w.text}</span>
            <small>{w.limit}</small>
          </a>
        ))}
      </div>
    </section>

    <section class="block" id="guides" aria-labelledby="ch-h">
      <h2 id="ch-h" data-split>Seven short guides</h2>
      <div class="chapters">
        {sections.map((s, i) => (
          <a class="ch-card" href={`/${s.id}`} data-reveal style={`--d:${i * 60}ms`}>
            <span class="ch-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[s.id]} /></svg></span>
            <h3>{s.title}</h3>
            <p>{blurbs[s.id]}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="block" aria-labelledby="rules-h">
      <h2 id="rules-h" data-split>Three rules for using it wisely</h2>
      <ul class="rules">
        {rules.map((r, i) => (
          <li data-reveal style={`--d:${i * 70}ms`}><h3>{r.title}</h3><p><Rich text={r.text} current="/" /></p></li>
        ))}
      </ul>
    </section>

    <a class="band" href={`/${sections[0]!.id}`}><span>Start here</span><b>{sections[0]!.title}</b></a>
  </div>
</Guide>
