---
import Guide from '../layouts/Guide.astro';
import Constellation from '../components/Constellation.astro';
import EvidenceCard from '../components/EvidenceCard.astro';
import Rich from '../components/Rich';
import Sources from '../components/Sources.astro';
import { sections } from '../data/guide';
import { verdicts } from '../data/brief';
import { takeaways } from '../data/display';
import { terms } from '../data/terms';
import { allClaims, gapDisplay, numberCites } from '../lib/content';

export function getStaticPaths() {
  return sections.map((s, i) => ({ params: { chapter: s.id }, props: { index: i } }));
}

const { index } = Astro.props;
const s = sections[index]!;
const route = `/${s.id}`;
const next = sections[index + 1];
const chapterTerms = terms[s.id] ?? [];
const own = new Set(s.claims.map((c) => c.id));
// Claims this chapter's summary leans on from other chapters come first, then its own.
const borrowed = (takeaways[s.id] ?? []).flatMap((a) => (a.claim && !own.has(a.claim) ? [a.claim] : []));
const list = [...borrowed.map((id) => allClaims.find((c) => c.id === id)!), ...s.claims];
const cites = numberCites(list.map((c) => c.id));
const plain = s.intro.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');
// The gap's last sentence can point at a page; keep the link working from here.
---
<Guide title={`${s.title}: AI field guide`} description={plain}>
  <div class="wash">
    <Constellation />
    <div class="wrap">
      <header class="open">
        <p class="open-step">Chapter {index + 1} of {sections.length}</p>
        <h1 data-split>{s.title}</h1>
        <p class="verdict" data-reveal style="--d:200ms">{verdicts[s.id]}</p>
      </header>
    </div>
  </div>
  <div class="wrap">
    {chapterTerms.length > 0 && (
      <section class="terms-row" aria-label="Terms used in this chapter">
        <div class="rows">
          <details class="row">
            <summary>New to this? Terms used in this chapter<span class="row-mark" aria-hidden="true"></span></summary>
            <dl class="terms">
              {chapterTerms.map((t) => <div><dt>{t.term}</dt><dd>{t.meaning}</dd></div>)}
            </dl>
          </details>
        </div>
      </section>
    )}

    <section class="block" id="evidence" aria-labelledby="ev-h">
      <div class="sec-head">
        <h2 id="ev-h" data-split>The evidence</h2>
        <p>{list.length} {list.length === 1 ? 'source' : 'sources'}, each with its catch</p>
      </div>
      <div class="ev-stack">
        {list.map((c) => <EvidenceCard claim={c} cite={cites.get(c.id)!} current={route} />)}
      </div>
    </section>

    {s.habits && (
      <section class="block" id="habits" aria-labelledby="habits-h">
        <h2 id="habits-h" data-split>What to do about it</h2>
        <ul class="habit-cards">
          {s.habits.map((h, i) => <li data-reveal style={`--d:${i * 70}ms`}><Rich text={h.text} current={route} /></li>)}
        </ul>
      </section>
    )}

    {s.gap && (
      <section class="block" aria-labelledby="gap-h">
        <div class="gap-card" data-reveal>
          <h2 id="gap-h">What is missing</h2>
          <p><Rich text={gapDisplay(s.gap)} current={route} /></p>
        </div>
      </section>
    )}

    <Sources cites={[...cites.values()]} current={route} />

    {next
      ? <a class="band" href={`/${next.id}`}><span>Next chapter</span><b>{next.title}</b></a>
      : <a class="band" href="/forecasts"><span>Next</span><b>Forecasts and evidence</b></a>}
  </div>
</Guide>
