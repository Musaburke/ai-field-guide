---
import Guide from '../layouts/Guide.astro';
import Constellation from '../components/Constellation.astro';
import { leads, panels } from '../data/panels';
import Citation from '../components/Citation';
import Rich from '../components/Rich';
import { Flags, ReadLine } from '../components/Evidence';
import { sections } from '../data/guide';
import { claimDate, claimLabel, figures, takeaways } from '../data/display';
import Sources from '../components/Sources.astro';
import { terms } from '../data/terms';
import { gapDisplay, numberCites } from '../lib/content';

export function getStaticPaths() {
  return sections.map((s, i) => ({ params: { chapter: s.id }, props: { index: i } }));
}

const { index } = Astro.props;
const s = sections[index]!;
const route = `/${s.id}`;
const prev = sections[index - 1];
const next = sections[index + 1];
const answers = takeaways[s.id]!;
const ids = new Set(s.claims.map((c) => c.id));
const stats = figures.filter((f) => ids.has(f.claim));
const chapterTerms = terms[s.id] ?? [];

// Numbered in reading order: takeaways first, then this chapter's own claims.
const when = (id: string) => {
  const m = `${claimDate[id] ?? ''} ${claimLabel[id] ?? ''}`.match(/(?:(\d{1,2}) )?(?:(January|February|March|April|May|June|July|August|September|October|November|December) )?(\d{4})/);
  return m ? Date.parse(`${m[1] ?? 1} ${m[2] ?? 'January'} ${m[3]}`) : Infinity;
};
// Oldest first. Claims with no date in their text follow at the end.
const trail = [...s.claims].sort((a, b) => when(a.id) - when(b.id));
const cites = numberCites([...answers.flatMap((a) => (a.claim ? [a.claim] : [])), ...trail.map((c) => c.id)]);
const plain = s.intro.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');
---
<Guide title={`${s.title}: AI field guide`} description={plain}>
  <div class="wash">
    <Constellation />
    <div class="wrap">
      <header class="open">
        <p class="open-step">Chapter {index + 1} of {sections.length}</p>
        <h1 data-split>{s.title}</h1>
        <p class="lead" data-reveal style="--d:200ms"><Rich text={leads[s.id] ?? s.intro} current={route} /></p>
        <nav class="jump" aria-label="On this page" data-reveal style="--d:300ms">
          <a href="#answer">Short answer</a>
          <a href="#evidence">Evidence</a>
          {s.habits && <a href="#habits">What to do</a>}
          <a href="#sources">Sources</a>
        </nav>
      </header>
    </div>
  </div>
  <div class="wrap">
    <section class="block" id="answer" aria-labelledby="answer-h">
      <h2 id="answer-h" data-split>The short answer</h2>
      <div class="features">
        {answers.map((a) => {
          const cite = a.claim ? cites.get(a.claim) : undefined;
          const panel = a.claim ? panels[a.claim] : undefined;
          const fig = stats.find((f) => f.claim === a.claim);
          return (
            <article class="feature" data-reveal>
              <div class="panel" aria-hidden="true">
                {panel?.bars ? panel.bars.map((b) => (
                  <div class="barline">
                    <span><span>{b.label}</span><span>{b.show}</span></span>
                    <i class:list={{ strong: b.strong }} style={`width:${b.value / 1.2}%`}></i>
                  </div>
                )) : panel?.label ? <p class="panel-label">{panel.label}</p>
                  : panel?.big ? <><p class="panel-big">{panel.big}</p>{panel.caption && <p class="panel-caption">{panel.caption}</p>}</>
                  : fig ? <p class="panel-big">{fig.value}</p>
                  : <p class="panel-label">{a.claim ? claimLabel[a.claim] : 'An admitted gap'}</p>}
              </div>
              <div class="feature-text">
                <p>{a.text}{cite && <>{' '}<Citation client:visible cite={cite} current={route} /></>}</p>
                {cite && <div class="feature-meta"><ReadLine read={cite.read} /></div>}
              </div>
            </article>
          );
        })}
      </div>
    </section>

    {chapterTerms.length > 0 && (
      <section class="block" aria-label="Terms used in this chapter">
        <div class="rows">
          <details class="row">
            <summary>New to this? Terms used in this chapter<span class="row-mark" aria-hidden="true"></span></summary>
            <dl class="terms">
              {chapterTerms.map((t) => <div><dt>{t.term}</dt><dd>{t.meaning}</dd></div>)}
            </dl>
          </details>
        </div>
      </section>
    )}

    <section class="block" id="evidence" aria-labelledby="ev-h">
      <h2 id="ev-h" data-split>The evidence</h2>
      <p class="block-note">Each source in turn, oldest first, with how far it can be trusted.</p>
      <ol class="tl" data-tl>
        <span class="tl-line" aria-hidden="true"><i data-tl-fill></i></span>
        {trail.map((c) => (
          <li class="tl-item" id={c.id} data-tl-item>
            <span class="tl-dot" aria-hidden="true"></span>
            <div class="tl-side">
              {claimDate[c.id] && <p class="tl-date">{claimDate[c.id]}</p>}
              <h3>{claimLabel[c.id]}</h3>
              <ReadLine read={c.read} />
              <Flags flags={c.flags} />
            </div>
            <div class="tl-body">
              <p><Rich text={c.text} current={route} /> <Citation client:visible cite={cites.get(c.id)!} current={route} /></p>
              {c.note && <p class="row-note"><Rich text={c.note} current={route} /></p>}
              <p class="tl-strength">Strength: {c.strength}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    {s.habits && (
      <section class="block" id="habits" aria-labelledby="habits-h">
        <h2 id="habits-h" data-split>Habits these sources support</h2>
        <ul class="habit-cards">
          {s.habits.map((h, i) => <li data-reveal style={`--d:${i * 70}ms`}><Rich text={h.text} current={route} /></li>)}
        </ul>
      </section>
    )}

    {s.gap && (
      <section class="block" aria-labelledby="gap-h">
        <h2 id="gap-h">What is missing</h2>
        <p class="gap"><Rich text={gapDisplay(s.gap)} current={route} /></p>
      </section>
    )}

    <Sources cites={[...cites.values()]} current={route} />

    {next
      ? <a class="band" href={`/${next.id}`}><span>Next chapter</span><b>{next.title}</b></a>
      : <a class="band" href="/evidence"><span>Next</span><b>All the evidence</b></a>}
  </div>
</Guide>
