---
import Guide from '../layouts/Guide.astro';
import Constellation from '../components/Constellation.astro';
import EvidenceCard from '../components/EvidenceCard.astro';
import Citation from '../components/Citation';
import FieldPicker from '../components/FieldPicker.astro';
import PromptBox from '../components/PromptBox.astro';
import Rich from '../components/Rich';
import Sources from '../components/Sources.astro';
import { sections } from '../data/guide';
import { verdicts } from '../data/brief';
import { playbooks } from '../data/playbooks';
import { terms } from '../data/terms';
import { allClaims, gapDisplay, numberCites } from '../lib/content';

export function getStaticPaths() {
  return sections.map((s, i) => ({ params: { chapter: s.id }, props: { index: i } }));
}

const { index } = Astro.props;
const s = sections[index]!;
const route = `/${s.id}`;
const next = sections[index + 1];
const chapterTerms = terms[s.id] ?? [];
const p = playbooks[s.id]!;
const proof = p.proof.map((id) => allClaims.find((c) => c.id === id)!);
const cites = numberCites(
  [...(p.uses ?? []), ...(p.topics ?? []), ...(p.fields ?? []), ...p.steps, ...p.careful]
    .flatMap((l) => l.cite ?? [])
    .concat(p.proof),
);
// `code` spans in the data render as code; nothing else is parsed.
const codeParts = (t: string) => t.split(/`([^`]+)`/);
---
<Guide title={`${s.title}: AI field guide`} description={verdicts[s.id]!}>
  <div class="wash">
    <Constellation />
    <div class="wrap">
      <header class="open">
        <p class="open-step">Guide {index + 1} of {sections.length}</p>
        <h1 data-split>{s.title}</h1>
        <p class="verdict" data-reveal style="--d:200ms">{verdicts[s.id]}</p>
      </header>
    </div>
  </div>
  <div class="wrap">
    {p.uses && (
      <section class="block" aria-labelledby="uses-h">
        <h2 id="uses-h" data-split>What it is great for</h2>
        <div class="uses">
          {p.uses.map((u, i) => (
            <article class="use" data-reveal style={`--d:${(i % 2) * 70}ms`}>
              <h3>{u.title}</h3>
              <p>{u.text} {u.cite?.map((id) => <Citation client:visible cite={cites.get(id)!} current={route} />)}</p>
              <PromptBox prompt={u.prompt} />
            </article>
          ))}
        </div>
      </section>
    )}

    {p.fields && (
      <section class="block" aria-labelledby="fields-h">
        <h2 id="fields-h" data-split>What it is great for in your field</h2>
        <FieldPicker fields={p.fields} cites={cites} current={route} />
      </section>
    )}

    {p.topics && (
      <section class="block" aria-labelledby="topics-h">
        <div class="sec-head">
          <h2 id="topics-h" data-split>Eight habits that pay off</h2>
          <p>In any AI tool, with Claude Code as the example</p>
        </div>
        <div class="rows topics" data-reveal>
          {p.topics.map((t, i) => (
            <details class="row" name="habit" open={i === 0}>
              <summary>{t.title}<span class="row-mark" aria-hidden="true"></span></summary>
              <div class="row-body">
                <p class="topic-habit">{t.habit}</p>
                <div class="topic-example">
                  <p class="prompt-label">In Claude Code</p>
                  <p>{codeParts(t.example).map((part, n) => n % 2 ? <code>{part}</code> : part)} {t.cite?.map((id) => <Citation client:visible cite={cites.get(id)!} current={route} />)}</p>
                </div>
                {t.prompt && <PromptBox prompt={t.prompt} />}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <section class="block" aria-labelledby="steps-h">
      <h2 id="steps-h" data-split>How to do it</h2>
      <ol class="steps">
        {p.steps.map((l, i) => (
          <li data-reveal style={`--d:${i * 50}ms`}>
            <span class="step-n" aria-hidden="true">{i + 1}</span>
            <div><h3>{l.title}</h3><p>{l.text} {l.cite?.map((id) => <Citation client:visible cite={cites.get(id)!} current={route} />)}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section class="block" aria-labelledby="careful-h">
      <h2 id="careful-h" data-split>Where to be careful</h2>
      <ul class="rules">
        {p.careful.map((l, i) => (
          <li data-reveal style={`--d:${i * 70}ms`}><h3>{l.title}</h3><p>{l.text} {l.cite?.map((id) => <Citation client:visible cite={cites.get(id)!} current={route} />)}</p></li>
        ))}
      </ul>
    </section>

    {p.notes && (
      <section class="block" aria-labelledby="notes-h">
        <h2 id="notes-h" data-split>What I learned building this site</h2>
        <p class="block-note">Musa Burke built this guide with Claude Code. These are his own notes, not study findings.</p>
        <ul class="notes">
          {p.notes.map((l, i) => (
            <li data-reveal style={`--d:${(i % 2) * 70}ms`}><h3>{l.title}</h3><p>{codeParts(l.text).map((part, n) => n % 2 ? <code>{part}</code> : part)}</p></li>
          ))}
        </ul>
      </section>
    )}

    {proof.length > 0 && (
      <section class="block" id="evidence" aria-labelledby="ev-h">
        <div class="sec-head">
          <h2 id="ev-h" data-split>Why we say this</h2>
          <p>{proof.length} {proof.length === 1 ? 'source' : 'sources'}, each with its catch</p>
        </div>
        <div class="ev-stack">
          {proof.map((c) => <EvidenceCard claim={c} cite={cites.get(c.id)!} current={route} />)}
        </div>
      </section>
    )}

    {s.gap && (
      <section class="block" aria-labelledby="gap-h">
        <div class="gap-card" data-reveal>
          <h2 id="gap-h">What is missing</h2>
          <p><Rich text={gapDisplay(s.gap)} current={route} /></p>
        </div>
      </section>
    )}

    {chapterTerms.length > 0 && (
      <section class="terms-row" aria-label="Terms used in this guide">
        <div class="rows">
          <details class="row">
            <summary>New to this? Terms used in this guide<span class="row-mark" aria-hidden="true"></span></summary>
            <dl class="terms">
              {chapterTerms.map((t) => <div><dt>{t.term}</dt><dd>{t.meaning}</dd></div>)}
            </dl>
          </details>
        </div>
      </section>
    )}

    <Sources cites={[...cites.values()]} current={route} />

    {next
      ? <a class="band" href={`/${next.id}`}><span>Next guide</span><b>{next.title}</b></a>
      : <a class="band" href="/sources"><span>Last page</span><b>Where this comes from</b></a>}
  </div>
</Guide>
