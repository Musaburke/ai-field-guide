---
import Guide from '../layouts/Guide.astro';
import Constellation from '../components/Constellation.astro';
import EvidenceFilter, { type Row } from '../components/EvidenceFilter';
import Sources from '../components/Sources.astro';
import { claimLabel } from '../data/display';
import { allClaims, numberCites, readCounts, readRank } from '../lib/content';

const sorted = [...allClaims].sort((a, b) => readRank[a.read] - readRank[b.read]);
const cites = numberCites(sorted.map((c) => c.id));
const rows: Row[] = sorted.map((c) => ({
  id: c.id,
  label: claimLabel[c.id] ?? c.id,
  text: c.text,
  read: c.read,
  strength: c.strength,
  flags: c.flags ?? [],
  note: c.note,
  chapter: c.chapter,
  chapterTitle: c.chapterTitle,
  cite: cites.get(c.id)!,
}));
const counts = readCounts(allClaims);
---
<Guide title="All the evidence: AI field guide" description="All claims in the guide, filtered by how they were read and flagged as contested, vendor or unresolved." current="/evidence">
  <div class="wash">
    <Constellation />
    <div class="wrap">
      <header class="open short">
        <h1 data-split>All the evidence</h1>
        <p class="lead" data-reveal style="--d:200ms">{allClaims.length} claims. {counts.page} checked on the source page, {counts.partial} partly, {counts.snippet} from a search summary only.</p>
      </header>
    </div>
  </div>
  <div class="wrap">
    <section class="block" aria-label="Claims">
      <EvidenceFilter client:load rows={rows} />
      <noscript><p>With JavaScript off, this list shows one group. Every claim is also in its chapter.</p></noscript>
    </section>
    <Sources cites={[...cites.values()]} />
  </div>
</Guide>
