---
import Base from '../layouts/Base.astro';
import EvidenceFilter, { type Row } from '../components/EvidenceFilter';
import Sources from '../components/Sources.astro';
import { allClaims, numberCites, readCounts, readRank } from '../lib/content';

const sorted = [...allClaims].sort((a, b) => readRank[a.read] - readRank[b.read]);
const cites = numberCites(sorted.map((c) => c.id));
const rows: Row[] = sorted.map((c) => ({
  id: c.id,
  text: c.text,
  read: c.read,
  strength: c.strength,
  flags: c.flags ?? [],
  note: c.note,
  chapter: c.chapter,
  chapterTitle: c.chapterTitle,
  cite: cites.get(c.id)!,
}));
const counts = readCounts(allClaims);
---
<Base title="Every claim, by evidence: AI field guide" description="All claims in the guide, ranked by how they were read and flagged as contested, vendor or unresolved.">
  <section class="opener on-accent">
    <h1 class="display opener-title">
      <span class="line"><span>Every claim,</span></span>
      <span class="line"><span>by evidence</span></span>
    </h1>
    <p class="opener-lead after-title">{allClaims.length} claims. {counts.page} checked on the source page, {counts.partial} partly, {counts.snippet} from a search summary only.</p>
  </section>
  <EvidenceFilter client:visible rows={rows} />
  <Sources cites={[...cites.values()]} current="/evidence" fold />
</Base>
