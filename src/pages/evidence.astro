---
import Guide from '../layouts/Guide.astro';
import Constellation from '../components/Constellation.astro';
import EvidenceFilter, { type Row } from '../components/EvidenceFilter';
import { briefs } from '../data/brief';
import { allClaims, readCounts } from '../lib/content';

const rows: Row[] = allClaims.map((c) => ({
  id: c.id,
  title: briefs[c.id]!.title,
  source: briefs[c.id]!.source,
  read: c.read,
  flags: c.flags ?? [],
  chapter: c.chapter,
  chapterTitle: c.chapterTitle,
}));
const counts = readCounts(allClaims);
const parts = [
  { n: counts.page, label: 'Checked on the source page', cls: 's-page' },
  { n: counts.partial, label: 'Partly checked', cls: 's-partial' },
  { n: counts.snippet, label: 'From a search summary only', cls: 's-snippet' },
];
---
<Guide title="How strong is the evidence? AI field guide" description="Every source in the guide at a glance, with how far each one was checked." current="/evidence">
  <div class="wash">
    <Constellation />
    <div class="wrap">
      <header class="open short">
        <h1 data-split>How strong is the evidence?</h1>
        <p class="verdict" data-reveal style="--d:200ms">Only {counts.page} of these {allClaims.length} sources were fully checked on the page itself. Here is which is which.</p>
      </header>
    </div>
  </div>
  <div class="wrap">
    <section class="block strength" aria-label="How far the sources were checked" data-reveal>
      <div class="strength-bar" aria-hidden="true">
        {parts.map((p) => <i class={p.cls} style={`flex:${p.n}`}></i>)}
      </div>
      <div class="strength-key">
        {parts.map((p) => <div><b>{p.n}</b><span><i class={p.cls}></i>{p.label}</span></div>)}
      </div>
    </section>
    <section class="block" aria-label="All sources">
      <EvidenceFilter client:load rows={rows} />
    </section>
  </div>
</Guide>
