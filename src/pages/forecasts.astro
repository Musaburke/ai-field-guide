---
import Guide from '../layouts/Guide.astro';
import Constellation from '../components/Constellation.astro';
import Citation from '../components/Citation';
import Rich from '../components/Rich';
import { Flags, ReadLine } from '../components/Evidence';
import Sources from '../components/Sources.astro';
import { forecasts, sections } from '../data/guide';
import { forecastPairs } from '../data/display';
import { briefs } from '../data/brief';
import { allClaims, claimHref, gapDisplay, numberCites } from '../lib/content';

const route = '/forecasts';
const paired = (id: string) => forecastPairs[id] ?? {};
// Paired forecasts first, so the difference shows before the unpaired ones.
const ordered = [...forecasts].sort((a, b) => Number(!forecastPairs[a.id]) - Number(!forecastPairs[b.id]));
const ids = ordered.flatMap((f) => {
  const c = f.id === 'f-wef' ? undefined : paired(f.id).claim;
  return c ? [f.id, c] : [f.id];
});
const cites = numberCites(ids);
---
<Guide title="Forecasts and evidence: AI field guide" description="Forecasts set beside what has been measured. Nothing here is a prediction by this guide." current="/forecasts">
  <div class="wash">
    <Constellation />
    <div class="wrap">
      <header class="open short">
        <h1 data-split>Forecasts and evidence</h1>
        <p class="verdict" data-reveal style="--d:200ms">Green cards are forecasts or opinions, not evidence. This guide makes no prediction of its own.</p>
      </header>
    </div>
  </div>
  <div class="wrap">
    <section class="block pairs" aria-label="Forecasts beside evidence">
      {ordered.map((f) => {
        const pair = paired(f.id);
        // The WEF forecast and claim are the same report, so link it rather than repeat it.
        const same = f.id === 'f-wef' ? allClaims.find((c) => c.id === pair.claim) : undefined;
        const claim = pair.claim && !same ? allClaims.find((c) => c.id === pair.claim) : undefined;
        const gap = pair.gapOf ? sections.find((s) => s.id === pair.gapOf)?.gap : undefined;
        return (
          <article class:list={["pair", { "pair-solo": !claim && !gap }]} data-reveal>
            <div class="pair-left" id={f.id}>
              <small>{briefs[f.id]!.source}</small>
              <h2>{briefs[f.id]!.title}</h2>
              <p class="pair-sum">{briefs[f.id]!.summary} <Citation client:visible cite={cites.get(f.id)!} current={route} /></p>
              <p class="row-note">{briefs[f.id]!.catch}</p>
              <div class="ev-meta"><ReadLine read={f.read} /><Flags flags={f.flags} /></div>
              {same && <p><a href={claimHref(same.id, route)}>Read it in {same.chapterTitle}</a></p>}
              {!claim && !gap && !same && <p class="pair-none">Nothing measured in this guide to set beside it.</p>}
              <details class="ev-more">
                <summary>Full detail<span class="row-mark" aria-hidden="true"></span></summary>
                <div class="ev-detail"><p><Rich text={f.text} current={route} /></p><p class="soft"><Rich text={f.caveat} current={route} /></p><p class="soft">{f.kind}</p></div>
              </details>
            </div>
            {(claim || gap) && (
              <div>
                <small>{claim ? 'What has been measured' : 'What is missing'}</small>
                {claim && (
                  <>
                    <h3>{briefs[claim.id]!.title}</h3>
                    <p class="pair-sum">{briefs[claim.id]!.summary} <Citation client:visible cite={cites.get(claim.id)!} current={route} /></p>
                    <p class="row-note">{briefs[claim.id]!.catch}</p>
                    <div class="ev-meta"><ReadLine read={claim.read} /><Flags flags={claim.flags} /></div>
                    <p><a href={claimHref(claim.id, route)}>Read it in {claim.chapterTitle}</a></p>
                  </>
                )}
                {gap && <p class="pair-sum"><Rich text={gapDisplay(gap).replace(/ The one SOC forecast found is on the \[[^\]]+\]\([^)]+\)\./, '')} current={route} /></p>}
              </div>
            )}
          </article>
        );
      })}
    </section>
    <Sources cites={[...cites.values()]} />
  </div>
</Guide>
