---
import Guide from '../layouts/Guide.astro';
import Constellation from '../components/Constellation.astro';
import Citation from '../components/Citation';
import Rich from '../components/Rich';
import { Flags, ReadLine } from '../components/Evidence';
import Sources from '../components/Sources.astro';
import { forecasts, sections } from '../data/guide';
import { claimLabel, forecastPairs } from '../data/display';
import { allClaims, claimHref, gapDisplay, numberCites } from '../lib/content';

const route = '/forecasts';
const paired = (id: string) => forecastPairs[id] ?? {};
// Paired forecasts first, so the difference shows before the unpaired ones.
const ordered = [...forecasts].sort((a, b) => Number(!forecastPairs[a.id]) - Number(!forecastPairs[b.id]));
const ids = ordered.flatMap((f) => {
  const c = paired(f.id).claim;
  return c ? [f.id, c] : [f.id];
});
const cites = numberCites(ids);
---
<Guide title="Forecasts and evidence: AI field guide" description="Forecasts set beside what has been measured. Nothing here is a prediction by this guide." current="/forecasts">
  <div class="wash">
    <Constellation />
    <div class="wrap">
      <header class="open short">
        <h1 data-split>Forecasts and evidence</h1>
        <p class="lead" data-reveal style="--d:200ms">Each green card is a forecast or an opinion, not evidence of what will happen. This guide makes no prediction of its own. Forecasters disagree, and several are vendors.</p>
      </header>
    </div>
  </div>
  <div class="wrap">
    <section class="block pairs" aria-label="Forecasts beside evidence">
      {ordered.map((f) => {
        const pair = paired(f.id);
        const claim = pair.claim ? allClaims.find((c) => c.id === pair.claim) : undefined;
        const gap = pair.gapOf ? sections.find((s) => s.id === pair.gapOf)?.gap : undefined;
        return (
          <article class="pair" data-reveal>
            <div class="pair-left" id={f.id}>
              <small>{f.kind}</small>
              <h2>{f.who}</h2>
              <p><Rich text={f.text} current={route} /> <Citation client:visible cite={cites.get(f.id)!} current={route} /></p>
              <p class="row-note"><Rich text={f.caveat} current={route} /></p>
              <ReadLine read={f.read} />
              <Flags flags={f.flags} />
            </div>
            <div>
              <small>What the guide has beside it</small>
              {claim && (
                <>
                  <h3>{claimLabel[claim.id]}</h3>
                  <p><Rich text={claim.text} current={route} /> <Citation client:visible cite={cites.get(claim.id)!} current={route} /></p>
                  {claim.note && <p class="row-note"><Rich text={claim.note} current={route} /></p>}
                  <ReadLine read={claim.read} />
                  <p class="tl-strength">Strength: {claim.strength}</p>
                  <Flags flags={claim.flags} />
                  <p><a href={claimHref(claim.id, route)}>In {claim.chapterTitle}</a></p>
                </>
              )}
              {gap && <p><Rich text={gapDisplay(gap).replace(/ The one SOC forecast found is on the \[[^\]]+\]\([^)]+\)\./, '')} current={route} /></p>}
              {!claim && !gap && <p class="pair-none">Nothing measured in this guide to set beside it.</p>}
            </div>
          </article>
        );
      })}
    </section>
    <Sources cites={[...cites.values()]} />
  </div>
</Guide>
