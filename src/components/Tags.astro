---
import { readLabel, flagLabel, type Read, type Flag } from '../data/guide';
interface Props { read: Read; strength?: string; flags?: Flag[] }
const { read, strength, flags = [] } = Astro.props;
---
<ul class="tags" aria-label="Evidence labels">
  {strength && <li class="tag tag-strength"><span class="tag-k">Evidence strength:</span> {strength}</li>}
  <li class={`tag tag-read tag-read-${read}`}>{readLabel[read]}</li>
  {flags.map((f) => <li class={`tag tag-flag tag-${f}`}>{flagLabel[f]}</li>)}
</ul>
