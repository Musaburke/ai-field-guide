---
// Renders text containing [label](url) links. No raw HTML is ever injected.
interface Props { text: string }
const { text } = Astro.props;
const parts: { t: string; href?: string }[] = [];
const re = /\[([^\]]+)\]\(([^)]+)\)/g;
let last = 0;
for (const m of text.matchAll(re)) {
  const i = m.index ?? 0;
  if (i > last) parts.push({ t: text.slice(last, i) });
  parts.push({ t: m[1], href: m[2] });
  last = i + m[0].length;
}
if (last < text.length) parts.push({ t: text.slice(last) });
---
{parts.map((p) =>
  p.href ? (
    <a href={p.href} {...(p.href.startsWith('http') ? { rel: 'noopener noreferrer' } : {})}>{p.t}</a>
  ) : (
    p.t
  ),
)}
